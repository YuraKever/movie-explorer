# TMDB credentials — get them at https://www.themoviedb.org/settings/api
# ONE of the two is enough (fill in either):

# 1) v4 Read Access Token (preferred) — a long string like eyJhbGciOi...
TMDB_ACCESS_TOKEN=

# 2) v3 API Key — a short key
TMDB_API_KEY=

# --- Database (Postgres) ---
# Local: `docker compose up -d db` starts Postgres with the string below.
# Production: the Neon connection string (same pg driver).
DATABASE_URL=postgres://movie:movie@localhost:5432/movie_explorer

# --- Better Auth ---
# Secret used to sign sessions: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the app (the production domain in production)
BETTER_AUTH_URL=http://localhost:3000
