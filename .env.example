# Креды TMDB — получить на https://www.themoviedb.org/settings/api
# Нужен ОДИН из двух вариантов (достаточно заполнить любой):

# 1) v4 Read Access Token (рекомендуется) — длинная строка вида eyJhbGciOi...
TMDB_ACCESS_TOKEN=

# 2) v3 API Key — короткий ключ
TMDB_API_KEY=

# --- База данных (Postgres) ---
# Локально: `docker compose up -d db` поднимет Postgres со строкой ниже.
# Прод: строка подключения из Neon (тот же драйвер pg).
DATABASE_URL=postgres://movie:movie@localhost:5432/movie_explorer

# --- Better Auth ---
# Секрет для подписи сессий: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Базовый URL приложения (в проде — прод-домен)
BETTER_AUTH_URL=http://localhost:3000
